# Required in Railway
ADMIN_USERNAME=choose-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=/data
SECURE_COOKIES=true

# Public URL and proxy handling
RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
ALLOWED_PUBLIC_HOSTS=your-service.up.railway.app
TRUST_PROXY_HEADERS=true
CORS_ORIGINS=

# Managed Xray Core inside this same container
XRAY_ENABLED=true
XRAY_BINARY_PATH=/usr/local/bin/xray
XRAY_CONFIG_PATH=/data/xray-config.json
XRAY_VLESS_PORT=10001
XRAY_TROJAN_PORT=10002
XRAY_LOG_LEVEL=warning
XRAY_RELOAD_INTERVAL=5

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Keep false unless every relay target is trusted and private networking is required
ALLOW_PRIVATE_TARGETS=false
