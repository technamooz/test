# Required in Railway
ADMIN_USERNAME=choose-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret
# Set true for one deploy to replace credentials saved in /data, then remove it.
ADMIN_RESET_CREDENTIALS=false
DATA_DIR=/data
SECURE_COOKIES=true

# Public URL and proxy handling
RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
ALLOWED_PUBLIC_HOSTS=your-service.up.railway.app
TRUST_PROXY_HEADERS=true
CORS_ORIGINS=

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Keep false unless every relay target is trusted and private networking is required
ALLOW_PRIVATE_TARGETS=false
